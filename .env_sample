# ---------------------------------------------------------------------------
# Imara Afya backend — environment
#
# Copy to .env before running anything. src/config/env.ts throws at boot on a
# missing required value, so a misconfigured deploy never opens its port.
# ---------------------------------------------------------------------------

# development | production — production disables GraphiQL and introspection
NODE_ENV=development
PORT=4000

# --- required ---
MONGODB_URI=
# 32+ characters. Changing it invalidates every session at once.
JWT_SECRET=

# --- database ---
# Keep (instances x DB_POOL_SIZE) under your Atlas connection limit.
DB_POOL_SIZE=10

# --- sessions ---
JWT_ISSUER=imara-afya
# how long one token lives
SESSION_DAYS=30
# how long a session may be renewed before the password must be typed again
MAX_SESSION_DAYS=365
# the ticket between proving a reset code and setting the new password
RESET_TOKEN_MINUTES=15

# --- one-time codes ---
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RESENDS_PER_HOUR=3
# how long a phone stays trusted before it is asked for a code again
DEVICE_TRUST_DAYS=90
# wrong current-password attempts before changePassword locks to email reset
MAX_PASSWORD_ATTEMPTS=5

# --- http ---
# Comma separated. LEAVING THIS EMPTY ALLOWS ANY ORIGIN — fine for the Expo
# app, which sends no Origin header, wrong once a web build exists.
FRONTEND_URL=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
BODY_LIMIT=1mb
MAX_QUERY_DEPTH=10

# --- email (Resend) ---
#
# Every one-time code goes through this. Without it, codes are printed to the
# server console in development and the request FAILS in production.
#
# STEP 1 (now): API key only. Resend's shared sender delivers ONLY to the
#   address your Resend account is registered with. Enough to test the whole
#   flow with your own email; nobody else receives anything.
#
# STEP 2 (before real users): add a domain in Resend, add the SPF and DKIM
#   records, wait for "Verified", then set MAIL_FROM to an address on it.
#   Until that is done, signup and new-device login work for nobody but you.
#   This is the launch blocker.
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=

# --- uploads ---
# where avatars are written, relative to the process working directory
UPLOAD_DIR=uploads
# largest image accepted before resizing, in megabytes
MAX_UPLOAD_MB=10
