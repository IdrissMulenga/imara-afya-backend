PORT=
MONGODB_URI=
JWT_SECRET=

# development | production — production disables GraphiQL and masks error details
NODE_ENV=

# comma separated list of allowed origins. Leave empty or use * to allow any.
# The Expo app sends no Origin header, but a web build would.
FRONTEND_URL=

# per-IP request cap on /graphql
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# mongo connection pool size for THIS instance.
# Keep (instances x DB_POOL_SIZE) under your Atlas cluster connection limit.
DB_POOL_SIZE=10

# Set to true ONLY for testing. It lets any logged-in user grant themselves the
# premium plan for free, because there is no payment step yet. Leave unset in
# production until a real payment check sits in front of upgradeToPremium.
ALLOW_SELF_UPGRADE=

# ---- Email (Resend) ----
# Password reset needs these. Without them the reset code is printed to the
# server console in development and the request fails in production.
#
# The free plan covers 3,000 emails a month and 100 a day — far more than
# password resets will use.
#
# STEP 1 (now): API key only.
#   Sign up at https://resend.com, create a key under API Keys with
#   "Sending access", and put it below. Leave MAIL_FROM empty.
#   Mail then goes out from Resend's shared test sender, which delivers ONLY to
#   the address your Resend account is registered with. Good enough to test the
#   whole reset flow with your own email; nobody else will receive anything.
#
# STEP 2 (before real users): add a domain.
#   Resend -> Domains -> add yours, then add the SPF and DKIM DNS records it
#   gives you and wait for "Verified". Then set MAIL_FROM to an address on that
#   domain. That single variable is the only change needed.
RESEND_API_KEY=
# Leave EMPTY until a domain is verified. Once set, it MUST be on that domain —
# Resend rejects anything else.
MAIL_FROM=
# optional: where replies go, if anyone answers the reset email
MAIL_REPLY_TO=

# Where the reset link in the email points. Defaults to the app's own scheme,
# which opens the installed app directly. Once you have a verified domain,
# switch to an https App Link (e.g. https://imaraco.bi/reset) — some mail
# clients refuse to make a custom scheme tappable at all.
APP_RESET_URL=
